# Supabase Backend Configuration
# Only public/publishable keys belong here — these are visible in the browser bundle.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# NOTE: Never add admin passwords, service-role keys, or database passwords as VITE_ variables.
# VITE_ variables are injected into the browser JavaScript bundle and visible to anyone.
# Admin authentication is handled exclusively by Supabase Auth — no frontend password storage.
